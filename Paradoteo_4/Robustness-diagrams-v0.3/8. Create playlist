@startuml
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX

boundary "Οθόνη Library" as B_LIB
boundary "Οθόνη Playlist Editor" as B_PE
boundary "Popup Σφάλματος: Το όνομα playlist\nΈχει ήδη Χρησιμοποιηθεί" as B_ERR #red

control "Εμφάνιση οθόνης <<Playlist Editor>>" as C_DPE
control "(Προεραιτικά) Άντληση εικόνας από τα αρχεία του Γενικού Χρήστη" as C_FS
control "Έλεγχος για συνωνυμία playlist\nμε άλλες playlist του Γενικού Χρήστη" as C_SN
control "Αποθήκευση νέας playlist στη βιβλιοθήκη"  as C_SV
control "Επιστροφή στη βιβλιοθήκη" as C_CCL #red
control "Εμφάνιση popup σφάλματος" as C_ERR #red
control "Επιστροφή στην οθόνη\n<<Playlist Editor>>\nγια αλλαγή ονόματος playlist" as C_RET #red

entity "Database" as E_DB
entity "Local File System" as E_FS
entity "Playlist" as E_PL

GX --> B_LIB : Επιλογή "Create New Playlist"
B_LIB --> C_DPE
C_DPE --> B_PE
GX --> B_PE : Εισαγωγή ονόματος, περιγραφής και δημοσιώτητας playlist
GX --> B_PE : (Προεραιτικά) Επιλογή εικόνας
B_PE --> C_FS : (Προεραιτικά)
C_FS --> E_FS
C_FS --> C_SN
B_PE --> C_SN
C_SN --> E_DB
C_SN --> C_SV : Δεν υπήρχε συνωνυμία
C_SN --> E_PL
GX -[#red]-> B_PE : <font color="red">Επιλογή Cancel</font>
B_PE -[#red]-> C_CCL
C_CCL -[#red]-> B_LIB
C_SN -[#red]-> C_ERR : <font color="red">Υπήρχε συνωνυμία</font>
C_ERR -[#red]-> B_ERR
GX -[#red]-> B_ERR : <font color="red">Ok</font>
B_ERR -[#red]-> C_RET
C_RET -[#red]-> B_PE


@enduml
