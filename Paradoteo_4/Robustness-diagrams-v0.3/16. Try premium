@startuml
skinparam defaultFontSize 12
left to right direction

actor "Βασικός Χρήστης" as GX

boundary "Οθόνη Προφίλ" as B_PRF
boundary "Οθόνη Premium" as B_PRM
boundary "Οθόνη επιτυχίας" as B_SUCCESS

control "Έλεγχος: έχει ξαναδοκιμάσει ο Βασικός Χρήστης Premium?" as C_HASTRIED
control "Εμφάνιση οθόνης Premium με την επιλογή για Free Trial" as C_WITHTRIAL
control "Πληρωμή μηδενικού ποσού" as C_PAY
control "Ενημέρωση βάσης για τον νέο τύπο λογαριασμού χρήστη" as C_UPDB
control "Εμφάνιση οθόνης επιτυχίας" as C_SUCCESS
control "Εμφάνιση οθόνης Premium χωρίς την επιλογή για Free Trial" as C_WITHOUTTRIAL #red

entity "Database" as E_DB
entity "User" as E_USR

usecase "Πληρωμή Μέσω\nΤραπεζικού Λογαριασμού" as UC_PAY

GX --> B_PRF : "Επιλογή <<Premium>>"
B_PRF --> C_HASTRIED
C_HASTRIED --> E_DB
C_HASTRIED --> E_USR
C_HASTRIED --> C_WITHTRIAL : "Ο Βασικός Χρήστης δεν\nέχει ξαναδοκιμάσει Premium"
C_WITHTRIAL --> B_PRM
GX --> B_PRM : "Επιλογή <<Free trial>>"
B_PRM --> C_PAY
C_PAY --> UC_PAY : "Πληρωμή με μηδενική αρχική χρέωση"
C_PAY --> C_UPDB
C_UPDB --> E_DB
C_UPDB --> E_USR
C_UPDB --> C_SUCCESS
C_SUCCESS --> B_SUCCESS
C_HASTRIED -[#red]-> C_WITHOUTTRIAL : <font color="red">Ο Βασικός χρήστης έχει</font><font color="red">ξαναδοκιμάσει premium</font>
C_WITHOUTTRIAL -[#red]-> B_PRM
B_PRM -[#red]-> GX : <font color="red">(δεν μπορεί αν επιλέξει Free Trial)</font>
@enduml
