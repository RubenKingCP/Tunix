@startuml UC_SelectPlaylist_Abstract
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX

boundary "Οθόνη Playlist" as B_PL
boundary "Οθόνη Μουσικής\n(Λίστα Τραγουδιών)" as B_MUSIC
boundary "Οθόνη Άδειας\nΛίστας" as B_EMPTY #red

control "Έλεγχος ύπαρξης\nτραγουδιών στην\nPlaylist" as C_PL
control "Ανάκτηση τραγουδιών\nαπό την βάση και\nεμφάνιση" as C_GT
control "Εμφάνιση οθόνης\nάδειας λίστας" as C_EM #red

entity "Database" as E_DB
entity "Song" as E_SONG

GX --> B_PL : επιλέγει playlist
B_PL --> C_PL
C_PL --> E_DB
C_PL --> C_GT
C_GT --> E_SONG
C_GT --> E_DB
C_GT --> B_MUSIC : εμφανίζει τραγούδια
B_MUSIC --> GX
C_PL -[#red]-> C_EM : <font color="red">δεν βρέθηκαν</font>\n<font color="red">τραγούδια</font>
C_EM -[#red]-> B_EMPTY
B_EMPTY -[#red]-> GX

@enduml
