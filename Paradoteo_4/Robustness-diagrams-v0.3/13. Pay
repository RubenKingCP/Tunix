@startuml
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX
actor "Τραπεζικό Σύστημα" as BNK

boundary "Οθόνη Πληρωμής" as B_PAY
control "Έλεγχος: υπάρχουν\nαποθηκευμένα τα τραπεζικά\nστοιχεία του ΓΧ?" as C_ISSAVED
control "Εμφάνιση Οθόνης Πληρωμής" as C_DSPPAY
control "Αποστολή αιτήματος\nμεταφοράς χρημάτων" as C_MONEYREQ
control "Εκτέλεση\nμεταφοράς\nχρημάτων" as C_SENDMONEY
control "Άντληση τραπεζικών\nστοιχείων του Γενικού Χρήστη" as C_FETCHBNKDATA #red
control "Αποθήκευση τραπεζικών\nστοιχείων του Γενικού Χρήστη" as C_SVBNK

entity "Database" as E_DB

C_ISSAVED --> E_DB
C_ISSAVED --> C_DSPPAY : οχι
C_DSPPAY --> B_PAY
GX --> B_PAY : Εισαγωγή τραπεζικών στοιχείων
B_PAY --> C_SVBNK
C_SVBNK --> E_DB
C_SVBNK --> C_MONEYREQ
C_MONEYREQ --> BNK
BNK --> C_SENDMONEY
C_ISSAVED -[#red]-> C_FETCHBNKDATA : <font color="red">ναι</font>
C_FETCHBNKDATA -[#red]-> E_DB
C_FETCHBNKDATA -[#red]-> C_MONEYREQ
@enduml
