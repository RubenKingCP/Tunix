@startuml
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX
actor "Τραπεζικό Σύστημα" as BNK

boundary "Οθόνη Πληρωμής" as B_PAY
boundary "Popup Αποτυχίας" as B_ERROR #red

control "Αποστολή αιτήματος\nμεταφοράς χρημάτων" as C_MONEYREQ
control "Εκτέλεση\nμεταφοράς\nχρημάτων" as C_SENDMONEY
control "Έλεγχος εγκυρότητας στοιχείων" as C_ISVALID
control "Εμφάνιση popup αποτυχίας" as C_ERROR #red

GX --> B_PAY : Εισαγωγή τραπεζικών στοιχείων
B_PAY --> C_ISVALID
C_ISVALID --> C_MONEYREQ : Τα στοιχεία είναι έγκυρα
C_MONEYREQ --> BNK
BNK --> C_SENDMONEY
C_ISVALID -[#red]-> C_ERROR : <font color="red">Τα στοιχεία είναι άκυρα</font>
C_ERROR -[#red]-> B_ERROR
B_ERROR -[#red]-> GX
@enduml
