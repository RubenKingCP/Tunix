@startuml UC_SelectPlaylist_Library
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX

boundary "Οθόνη Library" as B_LIB
boundary "Οθόνη Μουσικής\n(Λίστα Τραγουδιών)" as B_MUSIC
boundary "Οθόνη Άδειας\nΛίστας" as B_EMPTY #red

control "Ανάκτηση playlist\nτου χρήστη\nκαι εμφάνιση" as C_PL
control "Έλεγχος ύπαρξης\nτραγουδιών στην\nPlaylist" as C_SG
control "Ανάκτηση τραγουδιών\nαπό την βάση και\nεμφάνιση" as C_GT
control "Εμφάνιση οθόνης\nάδειας λίστας" as C_EM #red
control "Προσθήκη τραγουδιών στην playlist" as C_USG #red

entity "Database" as E_DB
entity "Song" as E_SONG
entity "Playlist" as E_PL
entity "User" as E_USR

usecase "Δημιουργία Λίστας\nΑναπαραγωγής" as UC_CR #red
usecase "Προσθήκη Τραγοδιών\nσε Λίστα Αναπαραγωγής" as UC_SG #red

C_PL --> B_LIB
C_PL --> E_PL
C_PL --> E_DB
C_PL --> E_USR
C_PL -[#red]-> UC_CR : <font color="red">[δεν βρέθηκαν playlist]</font><font color="red">επιλέγει Create Playlist</font>
GX --> B_LIB : επιλέγει playlist
B_LIB --> C_SG
C_SG --> E_DB
C_SG --> C_GT
C_GT --> E_SONG
C_GT --> E_DB
C_GT --> B_MUSIC : εμφανίζει τραγούδια
B_MUSIC --> GX
C_SG -[#red]-> C_EM : <font color="red">δεν βρέθηκαν</font>\n<font color="red">τραγούδια</font>
C_EM -[#red]-> B_EMPTY
GX -[#red]-> B_EMPTY : <font color="red">προσθήκη τραγουδιών</font>
B_EMPTY -[#red]-> C_USG
C_USG -[#red]-> UC_SG

@enduml
