@startuml
skinparam defaultFontSize 12
left to right direction

actor "Διαχειριστής" as GX

boundary "Οθόνη\nδιαχειριστή" as B_ADM
boundary "Οθόνη Artist\nAccount Applications" as B_REQ
boundary "Οθόνη Artist\nAccount Application\nDetails" as B_RD

control "Άντληση όλων\nτων αιτήσεων" as C_GTRQ
control "Εμφάνιση οθόνης\nArtist Account Applications" as C_SHRQ
control "Εμφάνιση οθόνης\nArtist Account\nApplication Details" as C_SHD
control "Έλεγχος:\nΕγκρίθηκε\nη αίτηση?" as C_ISACC
control "Ενημέρωση Γενικού\nΧρήστη για την\nΑπάντηση" as C_NOTIFY
control "Ενημέρωση Βάσης\nγια αλλαγή τύπου\nλογαριασμού" as C_UPDB
entity "Database" as E_DB
entity "UserToArtistRequest" as E_REQ
entity "User" as E_USR

GX --> B_ADM : Επιλογή <<Artist\nAccount Applications>>
B_ADM --> C_GTRQ
C_GTRQ --> E_DB
C_GTRQ --> E_REQ
C_GTRQ --> C_SHRQ
C_SHRQ --> B_REQ
GX --> B_REQ : Επιλογή αιτήματος
B_REQ --> C_SHD
C_SHD --> B_RD
GX --> B_RD : Έλεγχος αίτησης και\nέγκριση/απόρριψη
B_RD --> C_ISACC
C_ISACC --> C_UPDB : Η αίτηση εγκρίθηκε
C_UPDB --> E_USR
C_UPDB --> E_DB
C_UPDB --> C_NOTIFY
C_ISACC -[#red]-> C_NOTIFY : <font color="red">Η άιτηση απορρίφθηκε</font>

@enduml
