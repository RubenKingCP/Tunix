@startuml UC_SelectPlaylist_Library
skinparam defaultFontSize 12
left to right direction

actor "Γενικός Χρήστης" as GX

boundary "Βιβλιοθήκη" as B_LIB
boundary "Οθόνη Μουσικής" as B_MUSIC
boundary "Οθόνη Άδειας\nΛίστας" as B_EMPTY #red

control "Υπάρχουν playlist στην βιβλιοθήκη?" as C_ISLIBEMPTY
control "Ανάκτηση playlist\nτου χρήστη\nκαι εμφάνιση" as C_PL
control "Έλεγχος ύπαρξης\nτραγουδιών στην\nPlaylist" as C_SG
control "Ανάκτηση τραγουδιών\nαπό την βάση και\nεμφάνιση" as C_GT
control "Εμφάνιση οθόνης\nάδειας λίστας" as C_EM #red
control "Εμφάνιση κενής λίστας playlist" as C_PLEMPTY #orange

entity "Database" as E_DB
entity "Song" as E_SONG
entity "Playlist" as E_PL
entity "User" as E_USR

C_ISLIBEMPTY -->C_PL : βρέθηκαν playlist
C_PL --> B_LIB
C_ISLIBEMPTY --> E_PL
C_ISLIBEMPTY --> E_DB
C_ISLIBEMPTY --> E_USR
C_ISLIBEMPTY -[#orange]-> C_PLEMPTY : <font color="orange">δεν βρέθηκαν playlist</font>
C_PLEMPTY -[#orange]-> B_MUSIC
GX --> B_LIB : επιλέγει playlist
B_LIB --> C_SG
C_SG --> E_DB
C_SG --> C_GT : βρέθηκαν τραγούδια
C_GT --> E_SONG
C_GT --> E_DB
C_GT --> B_MUSIC
B_MUSIC --> GX
C_SG -[#red]-> C_EM : <font color="red">δεν βρέθηκαν</font>\n<font color="red">τραγούδια</font>
C_EM -[#red]-> B_EMPTY
GX <-[#red]- B_EMPTY

@enduml
