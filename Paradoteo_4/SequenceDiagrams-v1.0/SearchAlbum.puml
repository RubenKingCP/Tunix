@startuml SearchAlbum

title Search Album

actor User

participant MainPanel
participant TopBarView
participant TopBarController
participant SearchView
participant SearchController
participant SearchService
participant AlbumService
participant AlbumApi
participant ApiClient
participant AlbumBackendController
participant AlbumBackendService
participant AlbumBackendRepository


participant EventBus

activate TopBarView
User -> TopBarView : writes search query
User -> TopBarView : selects Album
User -> TopBarView : clicks on "Search"
TopBarView -> TopBarController : search(query,searchType)
deactivate TopBarView
activate TopBarController
TopBarController -> SearchService : searchAlbumByName(query)
activate SearchService
SearchService -> AlbumService : searchAlbumByName(query)
activate AlbumService
AlbumService -> AlbumApi : searchAlbumByName(query)
activate AlbumApi
AlbumApi -> ApiClient : post("album/getByName", query)
activate ApiClient
ApiClient -> AlbumBackendController : searchAlbumByName(query)
activate AlbumBackendController
AlbumBackendController -> AlbumBackendService : searchAlbumByName(query)
activate AlbumBackendService
AlbumBackendService -> AlbumBackendRepository : searchAlbumByName(query)
activate AlbumBackendRepository
AlbumBackendRepository --> AlbumBackendService : return results
deactivate AlbumBackendRepository
AlbumBackendService --> AlbumBackendController : return results
deactivate AlbumBackendService
AlbumBackendController --> ApiClient : return results
deactivate AlbumBackendController
ApiClient --> AlbumApi : return results
deactivate ApiClient
AlbumApi --> AlbumService : return results
deactivate AlbumApi
AlbumService --> SearchService : return results
deactivate AlbumService
SearchService --> TopBarController : return results
deactivate SearchService
TopBarController -> EventBus : publish SwitchMainScreenEvent, SearchController
deactivate TopBarController
activate EventBus
EventBus -> MainPanel : switchMainScreen(SearchController)
deactivate EventBus
activate MainPanel
create SearchController
MainPanel -->> SearchController : new(results)
deactivate MainPanel
activate SearchController
create SearchView
SearchController -->> SearchView : new()
activate SearchView
SearchController -> SearchView : showSearchResults(results)

@enduml