@startuml TryPremium

title Try Premium

actor User

participant UserProfileView
participant UserProfileController
participant UserService
participant UserApi
participant ApiService
participant UserBackendController
participant UserBackendService
participant UserBackendRepository


activate UserProfileView
User -> UserProfileView : clicks on "Try Premium"
UserProfileView -> UserProfileController : checkIfUserHasTriedPremium()
activate UserProfileController
UserProfileController --> UserProfileView : hasTriedPremium
deactivate UserProfileController
alt !hasTriedPremium
UserProfileView -> UserProfileController : tryPremium(userId)
activate UserProfileController
UserProfileController -> UserService : tryPremium(userId)
activate UserService
UserService -> UserApi : tryPremium(userId)
activate UserApi
UserApi -> ApiService : post(user/tryPremium,userId)
activate ApiService
ApiService -> UserBackendController : tryPremium(userId)
activate UserBackendController
UserBackendController -> UserBackendService : tryPremium(userId)
activate UserBackendService
UserBackendService -> UserBackendRepository : tryPremium(userId)
activate UserBackendRepository
UserBackendRepository --> UserBackendService : return success
deactivate UserBackendRepository
UserBackendService -> UserBackendController : return success
deactivate UserBackendService
UserBackendController --> ApiService : return success
deactivate UserBackendController
ApiService --> UserApi : return success
deactivate ApiService
UserApi --> UserService : return success
deactivate UserApi
UserService --> UserProfileController : return success
deactivate UserService
UserProfileController -> UserProfileView : showSuccessMessage("Trial started successfully")
else hasTriedPremium
UserProfileView -> UserProfileView : showErrorMessage("You have already tried premium")
end

@enduml